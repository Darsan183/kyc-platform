# KYC Platform - Production Environment Variables
# Copy to .env and update values

# Application
APP_ENV=production
APP_DEBUG=false

# JWT Security (REQUIRED - minimum 32 characters)
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters-long-change-this
JWT_ISSUER=kyc-platform

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/kycplatform
SPRING_DATASOURCE_USERNAME=kycuser
SPRING_DATASOURCE_PASSWORD=kycpass

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/password

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8080

# Document Storage
DOCUMENT_STORAGE_PATH=/app/documents